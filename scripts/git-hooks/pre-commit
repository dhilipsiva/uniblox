#!/usr/bin/env bash
# Tracked git pre-commit gate. Install once per clone: git config core.hooksPath scripts/git-hooks
# The commit boundary is where the test suite runs — clippy AND tests must pass. The coturn/redis
# tests are #[ignore]d, so the hook needs neither binary; `just ci` runs them too.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Run fmt/clippy/test under the pinned flake toolchain (DECISIONS.md ADR-0010), with coturn and
# redis on PATH, however git invokes the hook.
source scripts/lib/flake-env.sh

echo "[pre-commit] cargo fmt --check"
if ! cargo fmt --check; then
  echo "[pre-commit] FAILED: run 'cargo fmt' and re-stage." >&2
  exit 1
fi

echo "[pre-commit] cargo clippy --all-targets -- -D warnings"
if ! cargo clippy --all-targets -- -D warnings; then
  echo "[pre-commit] FAILED: fix clippy warnings before committing." >&2
  exit 1
fi

echo "[pre-commit] cargo test"
if ! cargo test; then
  echo "[pre-commit] FAILED: fix failing tests before committing." >&2
  exit 1
fi

# Mode-1 (standalone) must run with the networking stack ABSENT (ADR-0030).
echo "[pre-commit] standalone net-free check (cargo tree)"
if ! scripts/check-net-free.sh; then
  echo "[pre-commit] FAILED: see above." >&2
  exit 1
fi

echo "[pre-commit] OK"
exit 0
